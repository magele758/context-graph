{
  "name": "@opc/context-graph",
  "version": "0.1.0",
  "description": "Zero-dependency Two-Zone KV-Cache-Aware Property DAG context manager, compiler, REST microservice, and MCP server for coding & general agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=23.6.0"
  },
  "bin": {
    "context-graph": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./vector": "./src/vector.ts",
    "./graph-store": "./src/graph-store.ts",
    "./compiler": "./src/compiler.ts",
    "./server": "./src/server.ts",
    "./mcp": "./src/mcp.ts",
    "./benchmark": "./src/benchmark.ts"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magele758/context-graph.git"
  },
  "keywords": [
    "agent",
    "context-engineering",
    "context-graph",
    "kv-cache",
    "dag",
    "personalized-pagerank",
    "mcp",
    "sqlite",
    "opc"
  ],
  "scripts": {
    "start": "node src/cli.ts serve",
    "test": "node --test src/*.test.ts",
    "benchmark": "node src/cli.ts benchmark",
    "mcp": "node src/cli.ts mcp",
    "demo": "node src/cli.ts demo",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
